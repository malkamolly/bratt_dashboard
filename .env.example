# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored - never commit it.

# Supabase project URL (looks like: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key - SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps key for the Site Markup tool (Hub). SERVER ONLY - used only by
# the /api/site-map proxy routes, never sent to the browser. Needs the Maps
# Static API and Geocoding API enabled. Leave blank to disable the live map
# (photo markup still works without it).
GOOGLE_MAPS_API_KEY=

# --- Slack Tags (the /tags tag-triage board) --------------------------------
# All three are SERVER ONLY. The board is dark until they're set.
#
# From your Slack app's "Basic Information" page (api.slack.com/apps):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
#
# A 32-byte key used to encrypt each user's stored Slack token before it goes
# in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable — rotating it makes already-stored tokens undecryptable (users
# just reconnect). Never commit the real value.
SLACK_TOKEN_ENC_KEY=

# --- Video Notes (the /hub/video-notes AI walkthrough analyzer) -------------
# SERVER ONLY. Pay-as-you-go Anthropic API key from console.anthropic.com.
# NOTE: this is a *separate* billing account from any Claude Code / Claude.ai
# subscription — it's what the per-video analysis cost is charged against.
# The tool is dark until this is set.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for analysis. Defaults to
# claude-opus-5 (best quality). Set to claude-sonnet-5 for lower per-video cost.
VIDEO_NOTES_MODEL=
# (v2, not used yet) Transcription of the arborist's audio will use a Whisper
# service such as Groq (free tier). Add the key here when we build that step.
# GROQ_API_KEY=

# Secret that guards the scheduled daily-report endpoint (/api/tags/daily-report).
# Vercel Cron sends it as "Authorization: Bearer <this>". Set the SAME value here
# and in the Vercel Cron settings. Generate like the key above. Without it, the
# report can only be triggered by a signed-in owner (manual test).
CRON_SECRET=
