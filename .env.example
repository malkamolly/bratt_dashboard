# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored - never commit it.

# Supabase project URL (looks like: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key - SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps key for the Site Markup tool (Hub). SERVER ONLY - used only by
# the /api/site-map proxy routes, never sent to the browser. Needs the Maps
# Static API and Geocoding API enabled. Leave blank to disable the live map
# (photo markup still works without it).
GOOGLE_MAPS_API_KEY=
