# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored - never commit it.

# Supabase project URL (looks like: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key - SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps key for the Site Markup tool (Hub). SERVER ONLY - used only by
# the /api/site-map proxy routes, never sent to the browser. Needs the Maps
# Static API and Geocoding API enabled. Leave blank to disable the live map
# (photo markup still works without it).
GOOGLE_MAPS_API_KEY=

# --- Slack Tags (the /tags tag-triage board) --------------------------------
# All three are SERVER ONLY. The board is dark until they're set.
#
# From your Slack app's "Basic Information" page (api.slack.com/apps):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
#
# A 32-byte key used to encrypt each user's stored Slack token before it goes
# in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable — rotating it makes already-stored tokens undecryptable (users
# just reconnect). Never commit the real value.
SLACK_TOKEN_ENC_KEY=

# --- Video Notes (the /hub/video-notes AI walkthrough analyzer) -------------
# SERVER ONLY. Pay-as-you-go Anthropic API key from console.anthropic.com.
# NOTE: this is a *separate* billing account from any Claude Code / Claude.ai
# subscription — it's what the per-video analysis cost is charged against.
# The tool is dark until this is set.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for analysis. Defaults to
# claude-sonnet-5 (good quality/cost balance). Set to claude-opus-5 for maximum
# quality at higher per-video cost.
VIDEO_NOTES_MODEL=
# Powers Coach Mode's voice conversation — BOTH speech-to-text (Whisper) and
# the natural text-to-speech voice (Orpheus). One key does both. Free tier at
# console.groq.com. Without it, voice input/output degrade to typing + the
# device's built-in voice. SERVER ONLY.
GROQ_API_KEY=
# Optional: override the Whisper (speech-to-text) model. Default whisper-large-v3-turbo.
# GROQ_WHISPER_MODEL=

# --- Natural voice for Coach Mode (text-to-speech) --------------------------
# The voice PROVIDER is configuration, not code — every provider that copies the
# OpenAI /audio/speech shape works here (OpenAI, Groq, most inference hosts), so
# switching companies means editing these, not shipping a deploy.
#
# We moved off Groq for the outbound voice: its free tier allows only ~3,600
# tokens/day (about four spoken replies), which one coaching conversation blows
# through, and the paid upgrade was closed. Speech-to-TEXT still runs on Groq
# above — its Whisper limits are generous.
#
# SERVER ONLY. Without a key the natural voice is skipped and Coach Mode falls
# back to the browser's built-in voice.
TTS_API_KEY=
# Optional: defaults to https://api.openai.com/v1
# To return to Groq: https://api.groq.com/openai/v1
# TTS_BASE_URL=
# Optional: defaults to gpt-4o-mini-tts (the model that accepts TTS_INSTRUCTIONS).
# TTS_MODEL=
# Optional: which voice is used when the client doesn't name one. Default sage.
# TTS_DEFAULT_VOICE=
# Optional: plain-English delivery note, supported by gpt-4o-mini-tts. Has a
# coaching-tone default; set it EMPTY to send nothing, which is required for
# models that reject an unknown field (Groq's Orpheus among them).
# TTS_INSTRUCTIONS=
# Optional: comma-separated voices shown in the picker. Default sage,ash,cedar,marin.
# Exposed to the browser (voice names only, no secret).
# NEXT_PUBLIC_TTS_VOICES=
# Optional: audio format. Default mp3 — WAV is uncompressed and roughly ten
# times larger, which is a real wait before playback starts on cell service.
# TTS_FORMAT=

# Secret that guards the scheduled daily-report endpoint (/api/tags/daily-report).
# Vercel Cron sends it as "Authorization: Bearer <this>". Set the SAME value here
# and in the Vercel Cron settings. Generate like the key above. Without it, the
# report can only be triggered by a signed-in owner (manual test).
CRON_SECRET=
